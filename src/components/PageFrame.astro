---
/**
 * Override of Starlight's page frame.
 * Mochi-style: there is NO top header bar. The site title, controls and
 * search have been moved into the top of the sidebar (see Sidebar.astro),
 * so the sidebar spans the full viewport height and the main content starts
 * at the very top.
 *
 * The mobile menu toggle is kept (it needs somewhere to live on small
 * screens, where the sidebar collapses into a drop-down).
 */
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  {
    hasSidebar && (
      <nav
        class="sidebar print:hidden"
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
      >
        <div class="vx-mobile-bar md:sl-hidden">
          <MobileMenuToggle />
        </div>
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    /* Small mobile bar that holds the menu toggle (no full header). */
    .vx-mobile-bar {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--sl-z-index-navbar);
      height: var(--sl-nav-height);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      backdrop-filter: blur(8px);
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    /* On mobile the content clears the small toggle bar. */
    .main-frame {
      padding-top: calc(
        var(--sl-nav-height) + var(--sl-mobile-toc-height, 0px)
      );
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      .vx-mobile-bar {
        display: none;
      }
      /* Sidebar spans the full height, from the very top. */
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        inset-block: 0;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
      .sidebar-content {
        padding-top: 1.25rem;
      }
      /* No top bar on desktop, but keep breathing room above the
			   content so the page title isn't flush against the ceiling. */
      .main-frame {
        padding-top: 2.5rem;
      }
    }
  }
</style>
